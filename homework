
# ==============================
# SWIMMING POOL ENTRY CHECKER
# ==============================

print("=== Swimming Pool Entry Checker ===")
print("Answer 3 questions and I will tell you which pool you can use.\n")

# ---------- collect the three answers ----------
# YOUR CODE HERE
#   age         <- "How old are you? "                          wrapped in int()
#   can_swim    <- "Can you swim 25 metres? (yes / no): "       with .lower()
#   adult_here  <- "Is an adult with you? (yes / no): "         with .lower()

age = int(input("How old are you? "))
can_swim = input("Can you swim 25 metres? (yes / no): ").lower()
adult_here = input("Is an adult with you? (yes / no): ").lower()

print()
print("=== Entry Decision ===")
print("-" * 32)

# ---------- PART 1: age group, using if / elif / else on a NUMBER ----------
# YOUR CODE HERE
#   under 4       -> Toddler : splash pool only, always with an adult
#   under 12      -> Child   : main pool with an adult
#   under 18      -> Teen    : main pool alone if you can swim
#   anything else -> Adult   : all pools open to you
# Order matters here in a way it did not in class. The instructions explain why.

if age < 4:
    print("Toddler: splash pool only, always with an adult")
elif age < 12:
    print("Child: main pool with an adult")
elif age < 18:
    print("Teen: main pool alone if you can swim")
else:
    print("Adult: all pools open to you")

# ---------- PART 2: did they actually answer yes or no? ----------
# YOUR CODE HERE
# For can_swim: if it is not "yes" AND not "no", print an input error
# and set swim_known = False. Otherwise set swim_known = True.
# Do the same for adult_here, setting adult_known.

if can_swim != "yes" and can_swim != "no":
    print("Input error: please answer yes or no for swimming.")
    swim_known = False
else:
    swim_known = True

if adult_here != "yes" and adult_here != "no":
    print("Input error: please answer yes or no for adult presence.")
    adult_known = False
else:
    adult_known = True

# ---------- PART 3: AND - the deep pool ----------
# YOUR CODE HERE
# Allowed only when they CAN swim AND an adult IS present.

if can_swim == "yes" and adult_here == "yes":
    print("Deep pool: allowed")

# ---------- PART 4: OR - the shallow end ----------
# YOUR CODE HERE
# Warn when they are under 12 OR they cannot swim.

if age < 12 or can_swim == "no":
    print("Warning: Be careful in the shallow end.")

# ---------- PART 5: NOT - the lifeguard reminder ----------
# YOUR CODE HERE
# Remind when there is no adult - but only if adult_known is True.
# Think about why that extra check is needed before you write it.

if adult_known and not (adult_here == "yes"):
    print("Reminder: You need an adult with you.")

# ---------- PART 6: the final verdict ----------
# YOUR CODE HERE
# First: if either answer was not understood, refuse to decide.
# Then work through the real cases with elif, ending in a plain else.

if not swim_known or not adult_known:
    print("Cannot decide: please enter yes or no.")
elif age < 4 and adult_here == "yes":
    print("Verdict: Splash pool only.")
elif age < 4:
    print("Verdict: You must have an adult with you.")
elif age < 12 and adult_here == "yes":
    print("Verdict: Main pool with an adult.")
elif age < 12:
    print("Verdict: You must have an adult with you.")
elif age < 18 and can_swim == "yes":
    print("Verdict: Main pool alone is allowed.")
elif age < 18:
    print("Verdict: You need an adult or swimming supervision.")
else:
    print("Verdict: All pools open to you.")

print()
print("Have a safe swim!")